# ─────────────────────────────────────────────────────────────
#  GYRO STORE — Variables de entorno (copiar a .env y completar)
# ─────────────────────────────────────────────────────────────

# Entorno y puerto
NODE_ENV=development
PORT=3000

# URL pública de la app (para links en emails de invitación)
APP_URL=http://localhost:3000

# ── Firebase Admin SDK (servidor) ───────────────────────────
# Opción A (recomendada en Render): pegar el JSON completo del service account en una línea
FIREBASE_SERVICE_ACCOUNT_JSON=
# Opción B (local): ruta a un archivo de credenciales
SERVICE_ACCOUNT_PATH=.\Desktop\serviceAccountKey.json

# ── Firebase Web Config (cliente / login en el navegador) ───
# Opción A: JSON en una línea
FIREBASE_WEB_CONFIG=
# Opción B: campos sueltos
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ── Roles de arranque (whitelist por correo, sin tocar Firestore) ──
# El primer correo de ADMIN_EMAILS queda como global_admin protegido.
ADMIN_EMAILS=
SELLER_EMAILS=
PROTECTED_ADMIN_EMAIL=

# Dominio interno: los correos @gyrostore.com se consideran usuarios locales
INTERNAL_DOMAIN=gyrostore.com

# ── Cloudflare R2 (Storage de imágenes — reemplaza Firebase Storage) ──
# Panel de Cloudflare → R2 → tu bucket → Settings / API Tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# URL pública del bucket (dominio r2.dev o dominio propio), SIN barra final.
R2_PUBLIC_URL=
# Endpoint S3 de la cuenta (opcional: si se omite se arma con R2_ACCOUNT_ID).
R2_ENDPOINT=

# ── Negocio ─────────────────────────────────────────────────
WHATSAPP_NUMBER=50585944758
CURRENCY=C$
EXCHANGE_RATE=37

# ── Email SMTP (Gmail App Password) ─────────────────────────
# Opción A: JSON en una línea
EMAIL_CONFIG=
# Opción B: campos sueltos
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Gyro Store" <no-reply@gyrostore.com>

# ── CORS (dominio de producción permitido) ──────────────────
CORS_ORIGIN=http://localhost:3000
