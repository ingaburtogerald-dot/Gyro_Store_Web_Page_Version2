{
  "name": "gyro-store",
  "version": "1.0.0",
  "description": "Sistema web unificado de Gyro Store — catálogo público + centro de administración",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -n SERVER,FRONTEND -c blue,magenta \"npm:dev:server\" \"npm:dev:frontend\"",
    "dev:server": "cross-env NODE_ENV=development node --use-system-ca --watch-path=server --watch-path=shared server/index.js",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm install && npm run build",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "seed:template": "node scripts/seedTemplate.js",
    "postinstall": "echo \"Instala el frontend con: cd frontend && npm install\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1088.0",
    "@remix-run/express": "^2.17.5",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.0.2",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "sharp": "^0.35.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3"
  }
}
