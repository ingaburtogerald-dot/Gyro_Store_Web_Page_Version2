# ─────────────────────────────────────────────────────────────
#  GYRO STORE — Variables de entorno (copiar a .env y completar)
# ─────────────────────────────────────────────────────────────

# Entorno y puerto
NODE_ENV=development
PORT=3000

# URL pública de la app (para links en emails de invitación)
APP_URL=http://localhost:3000

# ── Firebase Admin SDK (servidor) ───────────────────────────
# Opción A (recomendada en Render): pegar el JSON completo del service account en una línea
FIREBASE_SERVICE_ACCOUNT_JSON=
# Opción B (local): ruta a un archivo de credenciales
SERVICE_ACCOUNT_PATH=./server/serviceAccountKey.json

# ── Firebase Web Config (cliente / login en el navegador) ───
# Opción A: JSON en una línea
FIREBASE_WEB_CONFIG=
# Opción B: campos sueltos
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ── Roles de arranque (whitelist por correo, sin tocar Firestore) ──
# El primer correo de ADMIN_EMAILS queda como global_admin protegido.
ADMIN_EMAILS=
SELLER_EMAILS=
PROTECTED_ADMIN_EMAIL=

# Dominio interno: los correos @gyrostore.com se consideran usuarios locales
INTERNAL_DOMAIN=gyrostore.com

# ── Negocio ─────────────────────────────────────────────────
WHATSAPP_NUMBER=50585944758
CURRENCY=C$
EXCHANGE_RATE=37

# ── Email SMTP (Gmail App Password) ─────────────────────────
# Opción A: JSON en una línea
EMAIL_CONFIG=
# Opción B: campos sueltos
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Gyro Store" <no-reply@gyrostore.com>

# ── CORS (dominio de producción permitido) ──────────────────
CORS_ORIGIN=http://localhost:3000
